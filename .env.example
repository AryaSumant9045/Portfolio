# No environment variables are required for the site itself.
#
# The contact form needs these three. Copy to `.env` and fill them in.
# SMTP_PASS must be a Google App Password (16 characters) — your normal
# Gmail password will be rejected if 2-Step Verification is enabled.

SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_TO=where-you-want-messages@gmail.com
